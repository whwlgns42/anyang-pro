# anyang-backend-api 9절 환경변수 목록. 값은 채우지 않는다 — 이름만.
DATABASE_URL=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
SCHEDULER_SHARED_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY와 같은 값. 브라우저 구독 코드(NEXT_PUBLIC_*)가 클라이언트 번들에 포함되므로 별도 변수로 노출한다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
APP_ORIGIN=
ADMIN_EMAILS=
# 공지 수집기 User-Agent에 넣는 문의 연락처(선택). 값은 직접 입력한다. 비우면 연락처 없는 UA로 수집한다.
COLLECTOR_CONTACT=

# --- 공지 수집 주체 변경(확인 항목 56, anyang-board-collector E절). 값은 채우지 않는다 ---
# 보드 수집기가 받기 API(POST /api/ingest/notices)에 보내는 인증 키. Vercel과 보드 collector.env에 같은 값을 넣는다. 비어 있으면 받기 API 전체 401.
COLLECTOR_INGEST_SECRET=
# Vercel 서버 직접 수집(/api/jobs/collect, 관리자 수동 수집) 스위치. true일 때만 동작, 없으면 410. 운영에서는 추가하지 않는다.
DIRECT_COLLECT_ENABLED=
# 아래는 보드 /etc/anyang-collector/collector.env 전용(Vercel에는 넣지 않는다). 받기 API 기준 주소와 보드 PostgreSQL 접속(libpq 표준 변수, 비밀번호 없음).
COLLECTOR_INGEST_URL=
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
