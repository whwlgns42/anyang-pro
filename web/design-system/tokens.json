{
  "$description": "청안 디자인 시스템 v0 토큰 (2026-09-30 초안). 이 파일이 원본이에요. 고친 뒤 `node build-tokens.mjs`로 tokens.css, tailwind.css, tokens.ts를 다시 만드세요.",
  "color": {
    "$type": "color",
    "paper": { "$value": "#F5F3ED", "$description": "배경" },
    "surface": { "$value": "#FCFBF8", "$description": "카드·입력창 면" },
    "rule": { "$value": "#DAD5C9", "$description": "구분선, 카드 테두리" },
    "field": { "$value": "#938D80", "$description": "입력창 테두리 (surface 대비 3.2:1)" },
    "ink": { "$value": "#17191E", "$description": "본문·제목 (paper 대비 15.8:1)" },
    "ink-2": { "$value": "#454A54", "$description": "발췌·설명 (paper 대비 8.0:1)" },
    "ink-3": { "$value": "#676C76", "$description": "날짜·메타, 안 고른 탭 (paper 대비 4.7:1, 글자색 하한)" },
    "accent": { "$value": "#1F4A7C", "$description": "행동·선택·근거 번호·내 말풍선 (paper 대비 8.1:1)" },
    "accent-press": { "$value": "#163A63", "$description": "기본 버튼 누름" },
    "on-accent": { "$value": "#FFFFFF", "$description": "accent 위 글자 (9.0:1)" },
    "danger": { "$value": "#A33A2B", "$description": "탈퇴·삭제 (paper 대비 5.9:1)" },
    "switch-off": { "$value": "#8C8679", "$description": "꺼진 스위치 트랙 (surface 대비 3.5:1)" },
    "disabled": { "$value": "#E4E0D6", "$description": "비활성 버튼 배경" }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Hahmlet", "AppleMyungjo", "serif"], "$description": "제목" },
    "sans": { "$value": ["IBM Plex Sans KR", "Apple SD Gothic Neo", "Noto Sans KR", "sans-serif"], "$description": "본문" },
    "mono": { "$value": ["IBM Plex Mono", "ui-monospace", "monospace"], "$description": "날짜·숫자" }
  },
  "text": {
    "$type": "typography",
    "display": {
      "$value": { "fontFamily": "{font.display}", "fontSize": "28px", "lineHeight": "36px", "fontWeight": 600, "letterSpacing": "-0.01em" },
      "$description": "탭 화면 제목"
    },
    "display-sm": {
      "$value": { "fontFamily": "{font.display}", "fontSize": "24px", "lineHeight": "34px", "fontWeight": 600, "letterSpacing": "-0.01em" },
      "$description": "공지 상세 제목"
    },
    "heading": {
      "$value": { "fontFamily": "{font.display}", "fontSize": "19px", "lineHeight": "28px", "fontWeight": 600, "letterSpacing": "0" },
      "$description": "안내 상자 제목 (예: iPhone 홈 화면 추가 안내)"
    },
    "title": {
      "$value": { "fontFamily": "{font.sans}", "fontSize": "16px", "lineHeight": "24px", "fontWeight": 600, "letterSpacing": "0" },
      "$description": "공지 제목, 설정 항목"
    },
    "body": {
      "$value": { "fontFamily": "{font.sans}", "fontSize": "15px", "lineHeight": "25px", "fontWeight": 400, "letterSpacing": "0" },
      "$description": "답변·본문"
    },
    "body-sm": {
      "$value": { "fontFamily": "{font.sans}", "fontSize": "14px", "lineHeight": "21px", "fontWeight": 400, "letterSpacing": "0" },
      "$description": "발췌, 설명"
    },
    "label": {
      "$value": { "fontFamily": "{font.sans}", "fontSize": "13px", "lineHeight": "18px", "fontWeight": 500, "letterSpacing": "0" },
      "$description": "카드 머리, 소제목"
    },
    "meta": {
      "$value": { "fontFamily": "{font.mono}", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 400, "letterSpacing": "0" },
      "$description": "날짜, 조건 줄"
    },
    "tab": {
      "$value": { "fontFamily": "{font.sans}", "fontSize": "11px", "lineHeight": "14px", "fontWeight": 500, "letterSpacing": "0" },
      "$description": "탭 바 글자 (현재 탭은 600)"
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "간격 단계 (px)",
    "4": { "$value": "4px" },
    "8": { "$value": "8px" },
    "12": { "$value": "12px" },
    "16": { "$value": "16px" },
    "20": { "$value": "20px" },
    "24": { "$value": "24px" },
    "32": { "$value": "32px" },
    "48": { "$value": "48px" }
  },
  "size": {
    "$type": "dimension",
    "touch": { "$value": "44px", "$description": "최소 터치 영역" },
    "gutter": { "$value": "20px", "$description": "화면 좌우 여백" },
    "control": { "$value": "48px", "$description": "입력창·보내기 버튼 높이" },
    "button-lg": { "$value": "52px", "$description": "하단 고정 기본 버튼 높이" }
  },
  "radius": {
    "$type": "dimension",
    "badge": { "$value": "4px", "$description": "본문 이미지 표시" },
    "card": { "$value": "6px", "$description": "근거 카드, 이미지 안내 상자" },
    "control": { "$value": "12px", "$description": "입력창, 버튼, 설정 묶음" },
    "bubble": { "$value": "18px", "$description": "내 말풍선" },
    "bubble-tail": { "$value": "4px", "$description": "내 말풍선 오른쪽 아래 모서리" },
    "pill": { "$value": "9999px", "$description": "스위치, 보내기 버튼" }
  },
  "border": {
    "$type": "dimension",
    "hairline": { "$value": "1px", "$description": "구분선, 카드 테두리" },
    "strong": { "$value": "2px", "$description": "목록 시작선 (ink)" }
  },
  "motion": {
    "duration-fast": { "$type": "duration", "$value": "150ms", "$description": "등장, 상태 변화" },
    "duration-base": { "$type": "duration", "$value": "200ms", "$description": "화면 전환" },
    "ease-out": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1], "$description": "기본 감속 곡선. prefers-reduced-motion이면 끄기" }
  }
}
